<!--index.wxml-->
<view class="page theme-{{theme}}" bindtap="onToggleFocus">

  <!-- 全屏氛围光：仅番茄休息阶段淡入 -->
  <view class="ambient {{mode === 'pomodoro' && pomodoroPhase === 'rest' ? 'is-on' : ''}}"></view>

  <!-- 左上角客服入口 -->
  <view class="contact-entry" wx:if="{{!focusMode}}" catchtap="openContactPanel">
    <view class="contact-icon"></view>
    <text>向我提需求</text>
  </view>

  <!-- 1 顶部模式栏 -->
  <view class="mode-bar" wx:if="{{!focusMode}}" catchtap="noop">
    <view wx:for="{{modes}}" wx:key="key" class="mode-tab {{mode === item.key ? 'active' : ''}}"
          data-mode="{{item.key}}" bindtap="onSwitchMode">{{item.label}}</view>
  </view>

  <!-- 2/3 子时间 + 主时间：作为一组垂直居中，间距固定 -->
  <view class="stage">
    <!-- 子时间区：固定占位，空字符串也保留高度 -->
    <view class="sub-time">
      <view class="phase-badge phase-{{pomodoroPhase}}" wx:if="{{mode === 'pomodoro'}}">
        <view class="phase-dot"></view>
        <text>{{subTime}}</text>
      </view>
      <block wx:else>{{subTime}}</block>
    </view>

    <!-- 主时间区：4 个组件常驻，非激活项 / 可编辑态隐藏 -->
    <view class="main-time style-{{style}} size-{{fontSize}} ff-{{fontFamily}} {{gradient ? 'is-gradient' : ''}} {{finished ? 'is-finished' : ''}}">
      <!-- 倒计时 / 番茄未开始时：页面自绘分段，可上下滑动调时 -->
      <view class="edit-time" wx:if="{{editable}}">
        <view class="edit-seg" data-unit="h" bindtouchstart="onEditTouchStart"
              catchtouchmove="onEditTouchMove" bindtouchend="onEditTouchEnd"
              bindtouchcancel="onEditTouchEnd">{{editH}}</view>
        <text class="edit-colon">:</text>
        <view class="edit-seg" data-unit="m" bindtouchstart="onEditTouchStart"
              catchtouchmove="onEditTouchMove" bindtouchend="onEditTouchEnd"
              bindtouchcancel="onEditTouchEnd">{{editM}}</view>
        <text class="edit-colon">:</text>
        <view class="edit-seg" data-unit="s" bindtouchstart="onEditTouchStart"
              catchtouchmove="onEditTouchMove" bindtouchend="onEditTouchEnd"
              bindtouchcancel="onEditTouchEnd">{{editS}}</view>
        <text class="edit-frac" wx:if="{{showCentis}}">.00</text>
      </view>
      <view class="edit-hint {{editTouched ? 'is-faded' : ''}}" wx:if="{{editable}}">上下滑动调整</view>

      <!-- 时钟闹钟提示：与「上下滑动调整」同款样式，绝对定位不参与布局 -->
      <view class="alarm-hint" wx:if="{{mode === 'clock' && alarmOn && !focusMode}}">闹钟 {{alarmText}}</view>

      <!-- 正计时计次预览：最多最近 2 行，超出显示 More -->
      <view class="lap-preview" wx:if="{{mode === 'stopwatch' && lapPreview.length && !focusMode}}" catchtap="noop">
        <view class="lap-line" wx:for="{{lapPreview}}" wx:key="index">第{{item.index}}次　{{item.cumulativeText}}</view>
        <text class="lap-more" wx:if="{{lapMore}}" catchtap="openLapPanel">More</text>
      </view>

      <clock-timer id="clock-timer" class="mode-host {{mode === 'clock' ? '' : 'hidden'}}"
                   data-mode="clock" show-centis="{{showCentis}}"
                   bind:statechange="onStateChange" bind:alarmfire="onAlarmFire" />
      <stopwatch-timer id="stopwatch-timer" class="mode-host {{mode === 'stopwatch' ? '' : 'hidden'}}"
                       data-mode="stopwatch" show-centis="{{showCentis}}" bind:statechange="onStateChange" />
      <countdown-timer id="countdown-timer"
                       class="mode-host {{mode === 'countdown' && !editable ? '' : 'hidden'}}"
                       data-mode="countdown" show-centis="{{showCentis}}" bind:statechange="onStateChange" />
      <pomodoro-timer id="pomodoro-timer"
                      class="mode-host {{mode === 'pomodoro' && !editable ? '' : 'hidden'}}"
                      data-mode="pomodoro" show-centis="{{showCentis}}" bind:statechange="onStateChange" />

      <!-- 番茄结束态：手动点提示进入下一阶段 -->
      <view class="next-stage"
            wx:if="{{mode === 'pomodoro' && finished && !focusMode && nextText}}"
            catchtap="onPomodoroNext">{{nextText}}</view>
    </view>

    <!-- 与子时间等高的空占位，让主时间成为整组的垂直中心 -->
    <view class="stage-balancer"></view>
  </view>

  <!-- 4 结束提示 -->
  <view class="time-up" wx:if="{{!focusMode && finished}}">时间到</view>

  <!-- 5 主操作组：重置 / 暂停 / 开始，贴边方向由 actionSide 决定 -->
  <view class="action-group {{actionSide === 'left' ? 'is-left' : ''}}"
        wx:if="{{!focusMode && (capabilities.toggle || capabilities.reset)}}" catchtap="noop">
    <view class="action-btn action-reset" wx:if="{{capabilities.reset}}" bindtap="onReset">重置</view>
    <view class="action-btn action-pause {{(!running || (mode === 'pomodoro' && finished)) ? 'is-disabled' : ''}}"
          wx:if="{{capabilities.toggle}}" bindtap="onPause">暂停</view>
    <view class="action-btn action-start {{(running || (mode === 'pomodoro' && finished)) ? 'is-disabled' : ''}}"
          wx:if="{{capabilities.toggle}}" bindtap="onStart">{{startLabel}}</view>
  </view>

  <!-- 5b 计次按钮：正计时运行中，位于操作组对侧 -->
  <view class="lap-btn {{actionSide === 'left' ? 'is-right' : 'is-left'}}"
        wx:if="{{!focusMode && mode === 'stopwatch' && running}}" bindtap="onLap">计次</view>

  <!-- 6 底部工具栏：第一行所有模式共有，第二行模式专属 -->
  <view class="toolbar" wx:if="{{!focusMode}}" catchtap="noop">
    <view class="toolbar-row toolbar-row--common">
      <view class="toolbar-btn" bindtap="onCycleStyle">
        <text class="toolbar-btn__desc">数字颜色</text>
        <text class="toolbar-btn__value">{{styleLabel}}</text>
      </view>
      <view class="toolbar-btn" bindtap="onToggleTheme">
        <text class="toolbar-btn__desc">背景颜色</text>
        <text class="toolbar-btn__value">{{theme === 'dark' ? '深色' : '浅色'}}</text>
      </view>
      <view class="toolbar-btn" bindtap="onCycleFontFamily">
        <text class="toolbar-btn__desc">字体</text>
        <text class="toolbar-btn__value">{{fontFamilyLabel}}</text>
      </view>
      <view class="toolbar-btn" bindtap="onCycleFontSize">
        <text class="toolbar-btn__desc">字号</text>
        <text class="toolbar-btn__value">{{fontSizeLabel}}</text>
      </view>
      <view class="toolbar-btn" bindtap="onTogglePrecision">
        <text class="toolbar-btn__desc">精度</text>
        <text class="toolbar-btn__value">{{showCentis ? '高' : '低'}}</text>
      </view>
      <view class="toolbar-btn" bindtap="onToggleGradient">
        <text class="toolbar-btn__desc">渐变</text>
        <text class="toolbar-btn__value">{{gradient ? '开' : '关'}}</text>
      </view>
      <view class="toolbar-btn" bindtap="onCycleEndAlert">
        <text class="toolbar-btn__desc">结束提醒</text>
        <text class="toolbar-btn__value">{{endAlertLabel}}</text>
      </view>
      <view class="toolbar-btn" bindtap="onToggleActionSide">
        <text class="toolbar-btn__desc">按钮位置</text>
        <text class="toolbar-btn__value">{{actionSide === 'left' ? '左侧' : '右侧'}}</text>
      </view>
    </view>
    <view class="toolbar-row toolbar-row--mode">
      <view class="toolbar-btn" wx:if="{{mode === 'clock'}}" bindtap="onAlarmTap">
        <text class="toolbar-btn__desc">闹钟</text>
        <text class="toolbar-btn__value">{{alarmOn ? alarmText : '关'}}</text>
      </view>
      <view class="toolbar-btn" wx:for="{{actions}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onActionTap">
        <text class="toolbar-btn__desc">{{item.label}}</text>
        <text class="toolbar-btn__value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 7 时长设置弹层（倒计时 / 工作 / 休息共用） -->
  <view class="mask" wx:if="{{durationTarget !== ''}}" catchtap="closeDurationPanel"></view>
  <view class="panel" wx:if="{{durationTarget !== ''}}" catchtap="noop">
    <view class="panel-title">{{durationTitle}}</view>
    <view class="panel-label">时长（时 : 分 : 秒）</view>
    <view class="panel-row">
      <input class="panel-input" type="number" value="{{durH}}" bindinput="onDurHInput" />
      <text class="panel-colon">:</text>
      <input class="panel-input" type="number" value="{{durM}}" bindinput="onDurMInput" />
      <text class="panel-colon">:</text>
      <input class="panel-input" type="number" value="{{durS}}" bindinput="onDurSInput" />
    </view>
    <view class="panel-actions">
      <button class="panel-btn" bindtap="applyDuration">确定</button>
      <button class="panel-btn secondary" bindtap="closeDurationPanel">关闭</button>
    </view>
  </view>

  <!-- 8 闹钟设置弹层（时 : 分） -->
  <view class="mask" wx:if="{{alarmPanelVisible}}" catchtap="closeAlarmPanel"></view>
  <view class="panel" wx:if="{{alarmPanelVisible}}" catchtap="noop">
    <view class="panel-title">闹钟</view>
    <view class="panel-label">时间（时 : 分）</view>
    <view class="panel-row">
      <input class="panel-input" type="number" value="{{alarmH}}" bindinput="onAlarmHInput" />
      <text class="panel-colon">:</text>
      <input class="panel-input" type="number" value="{{alarmM}}" bindinput="onAlarmMInput" />
    </view>
    <view class="panel-actions">
      <button class="panel-btn" bindtap="applyAlarm">确定</button>
      <button class="panel-btn secondary" wx:if="{{alarmOn}}" bindtap="clearAlarm">关闭闹钟</button>
      <button class="panel-btn secondary" bindtap="closeAlarmPanel">取消</button>
    </view>
  </view>

  <!-- 9 计次浮层：全部计次（累计 + 分段） -->
  <view class="mask" wx:if="{{lapPanelVisible}}" catchtap="closeLapPanel"></view>
  <view class="panel lap-panel" wx:if="{{lapPanelVisible}}" catchtap="noop">
    <view class="panel-title">全部计次</view>
    <scroll-view class="lap-list" scroll-y>
      <view class="lap-row" wx:for="{{laps}}" wx:key="index">
        <text class="lap-row__idx">第{{item.index}}次</text>
        <text class="lap-row__cum">{{item.cumulativeText}}</text>
        <text class="lap-row__split">+{{item.splitText}}</text>
      </view>
    </scroll-view>
    <view class="panel-actions">
      <button class="panel-btn secondary" bindtap="closeLapPanel">关闭</button>
    </view>
  </view>

  <!-- 10 联系我 -->
  <view class="mask" wx:if="{{contactPanelVisible}}" catchtap="closeContactPanel"></view>
  <view class="panel contact-panel" wx:if="{{contactPanelVisible}}" catchtap="noop">
    <view class="panel-title">联系我</view>
    <!-- 横屏高度有限：左侧文字与按钮，右侧二维码，避免竖排超屏 -->
    <view class="contact-body">
      <view class="contact-info">
        <view class="contact-tip">使用遇到问题，或想要新功能，直接加我微信</view>
        <text class="contact-id" selectable>{{wechatId}}</text>
        <view class="panel-actions">
          <button class="panel-btn" bindtap="copyWechatId">复制微信号</button>
          <button class="panel-btn secondary" bindtap="closeContactPanel">关闭</button>
        </view>
      </view>
      <image class="contact-qr" wx:if="{{contactQrVisible}}" src="/assets/contact-qr.jpg"
             mode="aspectFit" show-menu-by-longpress binderror="onQrError" />
    </view>
  </view>
</view>
